# PublicBid AI Assistant — environment template
# 이 파일은 커밋되는 템플릿이다. 실제 값은 절대 여기에 넣지 말고 `.env`에 넣는다.
# 로컬에서 사용하려면:  cp .env.example .env

# --- Runtime ---
# true 이면 LLM 호출 없이 mock RFP 분석 응답을 반환한다.
# 채용 담당자가 키 없이 서비스 워크플로를 확인할 수 있도록 기본값은 true.
MOCK_MODE=true

# 사용할 LLM 프로바이더. 값: gemini | openai
# gemini 는 Google AI Studio (aistudio.google.com) 에서 무료 API 키 발급 가능.
# openai 는 platform.openai.com 유료 계정 필요.
LLM_PROVIDER=gemini

# --- Google Gemini (기본 · 무료 티어) ---
# aistudio.google.com/apikey 에서 발급받아 `.env`에 채워 넣는다.
GEMINI_API_KEY=
# 무료 티어에서 사용 가능한 모델. gemini-2.0-flash / gemini-2.5-flash 등.
GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI (선택 · 유료) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Upload / CORS ---
# 업로드 최대 크기 (bytes). 기본 25MB.
MAX_PDF_BYTES=26214400
# 프론트엔드 개발 서버 origin. 여러 개면 콤마 구분.
CORS_ALLOW_ORIGINS=http://localhost:5173
